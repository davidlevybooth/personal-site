# Build-time: the site's public URL, used for the share image (set in Vercel as an environment variable)
VITE_SITE_URL=https://example.com
# Contact form, server-side only (never prefixed VITE_). Either email through Resend...
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=Site <onboarding@resend.dev>
# ...or a webhook (Slack, Discord, anything that takes JSON)
CONTACT_WEBHOOK=
